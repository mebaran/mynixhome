{
  "serverOverrides": {
    "nix": {
      "initializationOptions": {
        "nixpkgs": {
          "expr": "(builtins.getFlake (toString ./.)).inputs.nixpkgs.legacyPackages.aarch64-darwin"
        },
        "options": {
          "home-manager": {
            "expr": "(builtins.getFlake (toString ./.)).homeConfigurations.markbaran.options"
          }
        }
      }
    }
  }
}
